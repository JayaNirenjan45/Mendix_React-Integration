# Copy to `.env` and adjust. Every value here has a working default, so the file
# is only needed when your setup differs from the one described below.

# --- dev server only -------------------------------------------------------
# Where the Mendix runtime is listening. vite.config.js proxies /rest,
# /react-auth, /react-api, /file and /link to it, which puts React and Mendix on
# one origin and removes CORS and SameSite cookie problems entirely.
#
# Studio Pro's default is 8080 - but check nothing else has that port first.
MENDIX_RUNTIME_URL=http://localhost:8081

# React and Mendix share ONE Mendix session. Cookies are scoped by hostname and
# ignore the port, so React is served on the same hostname as the runtime and
# both apps use the same XASSESSIONID. vite refuses to start if the two
# hostnames differ.
#
#   React   http://localhost:5173
#   Mendix  http://localhost:8080
#
# REACT_DEV_HOST must match the hostname in MENDIX_RUNTIME_URL; leave it unset
# and it follows automatically.
# REACT_DEV_HOST=localhost
REACT_DEV_PORT=5173

# --- which Mendix runtime the API calls go to -------------------------------
# src/services/mendixConfig.js hardcodes the deployed app:
#
#   https://mxinterface.rapidhr.com
#
# so no variable is needed to talk to it. The deployment must allow this app's
# origin via CORS (Allow-Credentials: true, Allow-Headers: X-Csrf-Token) and
# issue XASSESSIONID as `SameSite=None; Secure`, because the calls are
# cross-site.
#
# To go back to the same-origin dev proxy against a LOCAL runtime, set BOTH:
#   VITE_MENDIX_URL=
#   MENDIX_RUNTIME_URL=http://localhost:8080

# --- ServiceRequests (rest/servicerequests/v1) ------------------------------
# The published service behind the four request pages: SubmitDriverRequest,
# DraftDriverRequest, SubmitFoodRequest, DraftFoodRequest,
# SubmitDigitalCardRequest, DraftDigitalCardRequest, submitabsence,
# absencedraft, and the replacedby / foodreqtypes / officelocation lookups.
#
# It lives under the same runtime as everything else, so the path is all that is
# configurable; change it only if the service's Path is renamed in Studio Pro.
# VITE_MENDIX_SVCREQ_BASE=/rest/servicerequests/v1

# submitabsence and absencedraft take the Fusion absence type the request is
# for. The Absence page is Annual Leave and has no type picker, so this is a
# constant. The default is the id the Postman collection ships - set it to the
# tenant's real Annual Leave id.
# VITE_ABSENCE_TYPE_ID=300000001234567

# --- calling the DEPLOYED Mendix app from a local React dev server ----------
# The deployment's nginx sends CORS headers, but pinned to one origin:
#
#   Access-Control-Allow-Origin: https://reactinterface.rapidhr.com
#
# so a browser will refuse a DIRECT call from any localhost origin, and its
# session cookies are __Host- prefixed (__Host-XASSESSIONID; Secure; HttpOnly;
# SameSite=Strict), which a cross-site request could not carry anyway.
#
# Route through the dev proxy instead: the browser only ever talks to this
# origin, so there is no CORS, and the cookies come back host-only on the dev
# host. Set BOTH:
#   VITE_MENDIX_URL=
#   MENDIX_RUNTIME_URL=https://mxinterface.rapidhr.com
