# Copy to `.env` and adjust. Every value here has a working default, so the file
# is only needed when your setup differs from the one described below.

# --- dev server only -------------------------------------------------------
# Where the Mendix runtime is listening. vite.config.js proxies /rest,
# /react-auth, /react-api, /file and /link to it, which puts React and Mendix on
# one origin and removes CORS and SameSite cookie problems entirely.
#
# Studio Pro's default is 8080 - but check nothing else has that port first.
MENDIX_RUNTIME_URL=http://localhost:8081

# React and Mendix share ONE Mendix session. Cookies are scoped by hostname and
# ignore the port, so React is served on the same hostname as the runtime and
# both apps use the same XASSESSIONID. vite refuses to start if the two
# hostnames differ.
#
#   React   http://localhost:5173
#   Mendix  http://localhost:8080
#
# REACT_DEV_HOST must match the hostname in MENDIX_RUNTIME_URL; leave it unset
# and it follows automatically.
# REACT_DEV_HOST=localhost
REACT_DEV_PORT=5173

# --- which Mendix runtime the API calls go to -------------------------------
# src/services/mendixConfig.js hardcodes the deployed app:
#
#   https://mxinterface.rapidhr.com
#
# so no variable is needed to talk to it. The deployment must allow this app's
# origin via CORS (Allow-Credentials: true, Allow-Headers: X-Csrf-Token) and
# issue XASSESSIONID as `SameSite=None; Secure`, because the calls are
# cross-site.
#
# To go back to the same-origin dev proxy against a LOCAL runtime, set BOTH:
#   VITE_MENDIX_URL=
#   MENDIX_RUNTIME_URL=http://localhost:8080
